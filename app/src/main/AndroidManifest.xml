<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 手机和电视共用一个 APK：电视没有触屏，也不要求 Leanback 界面库 -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 应用内更新：下载新版后调起系统安装 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 后台播放：前台服务（媒体播放）、播放网络文件时保持网络和 CPU 唤醒 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- 网页字幕：读不到声音的网页视频（有版权保护等）用系统的播放捕获读取译幕自己放出的声音，用到时才申请 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 识别、翻译进度显示在通知栏（Android 13 起要用户允许） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 读取手机里的视频和音频（媒体库） -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Android 8/9 上重命名、移动、删除文件需要 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- 判断有没有浏览器（很多电视没有，网盘登录改用手机扫码）：Android 11 起要声明才查得到 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <!-- 离线翻译：绑定 Offline Translator App 的翻译服务 -->
        <package android:name="dev.davidv.translator" />
    </queries>

    <application
        android:name=".VoxtitleApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:banner="@drawable/tv_banner"
        android:label="译幕"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <!-- singleTask：从别的 App 分享链接、用其他应用打开视频时，回到已经开着的译幕（onNewIntent），
             不在对方的任务里再开一个界面——两个界面会各建一个播放器和媒体会话，媒体会话重复就闪退 -->
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:supportsPictureInPicture="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- 电视桌面（Android TV / Google TV）入口 -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- 允许从文件管理器"用其他应用打开"视频 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="video/*" />
            </intent-filter>
            <!-- 光盘镜像（ISO） -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="application/x-iso9660-image" />
            </intent-filter>
        </activity>

        <!-- 后台播放：媒体会话服务，播放时显示通知栏控制，锁屏、耳机按键可控制 -->
        <service
            android:name=".PlaybackService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
        <!-- 网页字幕：读取系统声音（播放捕获） -->
        <service
            android:name=".web.CaptureService"
            android:foregroundServiceType="mediaProjection"
            android:exported="false" />
        <!-- 桌面小组件：正在播放的歌曲和播放控制 -->
        <receiver
            android:name=".NowPlayingWidget"
            android:exported="false"
            android:label="译幕 · 正在播放">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_now_playing_info" />
        </receiver>
        <!-- 应用内更新下载的安装包交给系统安装器 -->
        <provider
            android:name=".update.UpdateFileProvider"
            android:authorities="${applicationId}.update"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>
    </application>
</manifest>
