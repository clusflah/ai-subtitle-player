<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面小组件 4×3：和 4×2 一样，封面更大；下面三行歌词（上一句、正在唱的那句突出、下一句） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_cover"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:background="@drawable/widget_cover_background"
            android:clipToOutline="true"
            android:contentDescription="封面"
            android:scaleType="centerCrop"
            android:src="@drawable/widget_cover_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:marqueeRepeatLimit="marquee_forever"
                android:singleLine="true"
                android:text="没有在播放"
                android:textColor="#FFFFFFFF"
                android:textSize="17sp"
                android:textStyle="bold">

                <!-- 放不下时滚动：小组件里只有拿到焦点的那一行能跑马灯 -->
                <requestFocus />
            </TextView>

            <TextView
                android:id="@+id/widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="译幕"
                android:textColor="#B3FFFFFF"
                android:textSize="13sp" />

            <!-- 播放控制：♡ 上一首 播放 下一首，平分一行 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_like"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_button_background"
                    android:contentDescription="喜欢"
                    android:padding="7dp"
                    android:src="@drawable/widget_heart" />

                <ImageView
                    android:id="@+id/widget_prev"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_button_background"
                    android:contentDescription="上一首"
                    android:padding="6dp"
                    android:src="@drawable/widget_prev" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <ImageView
                        android:id="@+id/widget_play"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:background="@drawable/widget_play_background"
                        android:contentDescription="播放 / 暂停"
                        android:padding="10dp"
                        android:src="@drawable/widget_play" />
                </FrameLayout>

                <ImageView
                    android:id="@+id/widget_next"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_button_background"
                    android:contentDescription="下一首"
                    android:padding="6dp"
                    android:src="@drawable/widget_next" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 歌词占剩下的高度，居中 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_lyric_prev"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#80FFFFFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/widget_lyric"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#FFFFB347"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_lyric_next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#80FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
