<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面小组件「正在播放」（NowPlayingWidget） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="10dp"
    android:paddingVertical="8dp">

    <ImageView
        android:id="@+id/widget_cover"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/widget_cover_background"
        android:clipToOutline="true"
        android:contentDescription="封面"
        android:scaleType="centerCrop"
        android:src="@drawable/widget_cover_placeholder" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="没有在播放"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="译幕"
            android:textColor="#B3FFFFFF"
            android:textSize="13sp" />

        <!-- 正在唱的那句歌词；有歌词时代替歌手那行 -->
        <TextView
            android:id="@+id/widget_lyric"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFB347"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_prev"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/widget_button_background"
        android:contentDescription="上一首"
        android:padding="8dp"
        android:src="@drawable/widget_prev"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/widget_play"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginHorizontal="2dp"
        android:background="@drawable/widget_play_background"
        android:contentDescription="播放 / 暂停"
        android:padding="10dp"
        android:src="@drawable/widget_play" />

    <ImageView
        android:id="@+id/widget_next"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/widget_button_background"
        android:contentDescription="下一首"
        android:padding="8dp"
        android:src="@drawable/widget_next"
        android:visibility="gone" />
</LinearLayout>
