<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面小组件「正在播放」（NowPlayingWidget）：上面一行封面、歌名歌手和播放控制，下面一整行显示正在唱的歌词 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_cover"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/widget_cover_background"
            android:clipToOutline="true"
            android:contentDescription="封面"
            android:scaleType="centerCrop"
            android:src="@drawable/widget_cover_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:marqueeRepeatLimit="marquee_forever"
                android:singleLine="true"
                android:text="没有在播放"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold">

                <!-- 放不下时滚动：小组件里只有拿到焦点的那一行能跑马灯 -->
                <requestFocus />
            </TextView>

            <TextView
                android:id="@+id/widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="译幕"
                android:textColor="#B3FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_prev"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_button_background"
            android:contentDescription="上一首"
            android:padding="8dp"
            android:src="@drawable/widget_prev"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/widget_play"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/widget_play_background"
            android:contentDescription="播放 / 暂停"
            android:padding="10dp"
            android:src="@drawable/widget_play" />

        <ImageView
            android:id="@+id/widget_next"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_button_background"
            android:contentDescription="下一首"
            android:padding="8dp"
            android:src="@drawable/widget_next"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 正在唱的那句歌词：占满一整行，放不下才缩小字号；小组件不够高时由这一行让出空间，上面一行不被截断 -->
    <TextView
        android:id="@+id/widget_lyric"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:autoSizeMaxTextSize="15sp"
        android:autoSizeMinTextSize="11sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="#FFFFB347"
        android:textSize="15sp"
        android:visibility="gone" />
</LinearLayout>
