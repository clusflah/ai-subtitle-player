<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面小组件 2×2：上面封面和播放键，下面歌名、正在唱的那句（没有歌词时显示歌手） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_cover"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/widget_cover_background"
            android:clipToOutline="true"
            android:contentDescription="封面"
            android:scaleType="centerCrop"
            android:src="@drawable/widget_cover_placeholder" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/widget_play"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_play_background"
            android:contentDescription="播放 / 暂停"
            android:padding="10dp"
            android:src="@drawable/widget_play" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="marquee"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:marqueeRepeatLimit="marquee_forever"
        android:singleLine="true"
        android:text="没有在播放"
        android:textColor="#FFFFFFFF"
        android:textSize="15sp"
        android:textStyle="bold">

        <!-- 放不下时滚动：小组件里只有拿到焦点的那一行能跑马灯 -->
        <requestFocus />
    </TextView>

    <TextView
        android:id="@+id/widget_lyric"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="2dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="3"
        android:text="译幕"
        android:textColor="#FFFFB347"
        android:textSize="13sp" />
</LinearLayout>
